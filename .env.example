# ---------------------------------------------------------------------------
# JARVIS environment configuration
# Copy this file to .env.local and fill in what you need.
# ALL keys are optional. JARVIS runs in a limited local mode without any keys
# (local JSON storage + Ollama if it is running). Add providers as you like.
# ---------------------------------------------------------------------------

# --- AI PROVIDERS (server-side only, never exposed to the browser) ----------

# Google Gemini (free tier). https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq (free tier). https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (has free models, e.g. ":free" suffixed models).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional attribution headers for OpenRouter
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=JARVIS AI Harness

# Ollama local inference. No key required.
OLLAMA_BASE_URL=http://localhost:11434

# --- PERSISTENT STORAGE (optional but recommended) -------------------------
# When both values are present, JARVIS uses Supabase.
# Otherwise it uses the local JSON file store at .data/jarvis.json.
# Supabase free tier: https://supabase.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local JSON storage path (used when Supabase is not configured).
JARVIS_DATA_FILE=.data/jarvis.json

# --- ACCESS PROTECTION (strongly recommended when not local-only) ----------
# When set, the UI and every API route (except /api/health and /api/auth)
# require this bearer token. Generate a long random value, for example:
#   [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
JARVIS_ACCESS_TOKEN=

# In-memory, per-process API rate limiting. General routes and chat/resume
# routes have separate limits per IP per window.
JARVIS_RATE_LIMIT_MAX=240
JARVIS_CHAT_RATE_LIMIT_MAX=60
JARVIS_RATE_LIMIT_WINDOW_MS=60000

# --- HARNESS DEFAULTS (optional) -------------------------------------------
# Default model in the form "provider:model"
JARVIS_DEFAULT_MODEL=gemini:gemini-3.6-flash
# Maximum agent loop iterations per run
JARVIS_MAX_ITERATIONS=6
# Per-provider request timeout in milliseconds
JARVIS_PROVIDER_TIMEOUT_MS=60000
# Per-tool execution timeout in milliseconds
JARVIS_TOOL_TIMEOUT_MS=15000
# Upper bound for approximate context tokens (heuristic, chars/4)
JARVIS_CONTEXT_TOKEN_BUDGET=12000
# How many long-term memories to inject per turn
JARVIS_MEMORY_LIMIT=5

# --- SAFETY -----------------------------------------------------------------
# Directory that file tools are sandboxed to (relative to project root).
JARVIS_WORKSPACE_DIR=.workspace
# Comma separated allowlist for the shell tool (only these binaries run,
# without a shell). The tool is off by default and every run needs approval.
JARVIS_SHELL_ALLOWLIST=git,node
# Set to "true" to enable the shell tool (still permission-gated and
# approval-gated). Left false by default.
JARVIS_ENABLE_SHELL=false
